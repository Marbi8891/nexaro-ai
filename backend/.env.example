# ── Copia este archivo como .env y rellena los valores ─────────────
# cp .env.example .env

# APP
APP_NAME="NexaroAI API"
ENVIRONMENT=development

# GENERA CON: openssl rand -hex 32
SECRET_KEY=CAMBIA_ESTO_openssl_rand_hex_32

# DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/nexaroai

# CORS (JSON array con tus dominios)
CORS_ORIGINS=["http://localhost:8080","https://nexaroai.agency"]

# EMAIL (EMAIL_MOCK=true → solo logs, no envía nada)
EMAIL_MOCK=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=hola@nexaroai.agency
EMAIL_FROM_NAME=NexaroAI Agency

# ADMIN PANEL
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CambiaMeEnProduccion2024!
ACCESS_TOKEN_EXPIRE_MINUTES=480

