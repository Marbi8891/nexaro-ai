# ─────────────────────────────────────────────────────────────────────────────
# NEXARO AI — Variables de entorno
# ─────────────────────────────────────────────────────────────────────────────
#
# Copia este archivo a .env y rellena con tus valores reales.
#
#   cp .env.example .env
#
# ⚠️  NUNCA subas .env a git. Ya está en .gitignore.
# ⚠️  NUNCA dejes valores vacíos en producción — la app no arrancará.
#
# Generar SECRET_KEY segura:
#   openssl rand -hex 32
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# ─────────────────────────────────────────────────────────────────────────────


# ── Entorno ───────────────────────────────────────────────────────────────────
# Valores: development | production
# En producción: activa validación de secretos, oculta errores, desactiva Swagger
ENVIRONMENT=development


# ── Seguridad — OBLIGATORIAS ──────────────────────────────────────────────────
# SECRET_KEY: mínimo 32 caracteres aleatorios
# En producción, la app rechaza valores cortos o de la lista negra
SECRET_KEY=

# Credenciales del panel CRM admin
# En producción: ADMIN_PASSWORD mínimo 12 caracteres
ADMIN_USERNAME=
ADMIN_PASSWORD=


# ── Base de datos ─────────────────────────────────────────────────────────────
# Local con Docker Compose:
#   DATABASE_URL=postgresql+asyncpg://nexaro:nexaro_local@localhost:5432/nexaro_dev
#
# Render (reemplaza 'postgres://' por 'postgresql+asyncpg://'):
#   DATABASE_URL=postgresql+asyncpg://user:pass@host.render.com:5432/dbname
DATABASE_URL=postgresql+asyncpg://nexaro:nexaro_local@localhost:5432/nexaro_dev


# ── JWT ───────────────────────────────────────────────────────────────────────
# Tiempo de expiración del token de acceso en minutos
# Default: 480 (8 horas) — adecuado para panel admin de uso diario
ACCESS_TOKEN_EXPIRE_MINUTES=480


# ── CORS ──────────────────────────────────────────────────────────────────────
# Array JSON con los orígenes permitidos
# Local:       '["http://localhost:8080", "http://localhost:3000"]'
# Producción:  '["https://mrabehfathi.com", "https://www.mrabehfathi.com"]'
CORS_ORIGINS=["http://localhost:8080", "http://localhost:3000"]


# ── Email ─────────────────────────────────────────────────────────────────────
# EMAIL_MOCK=true → solo imprime en logs, no envía email real
# EMAIL_MOCK=false → requiere SMTP_HOST, SMTP_USER, SMTP_PASSWORD configurados
EMAIL_MOCK=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=


# ── Tests ─────────────────────────────────────────────────────────────────────
# NO incluir TESTING=true en .env de producción
# Se activa desde la CLI al ejecutar tests:
#   TESTING=true python -m pytest tests/ -v
#
# Cuando TESTING=true:
#   - Usa SQLite en memoria en lugar de PostgreSQL
#   - Desactiva rate limiting (slowapi)
